# Copy to .env and fill in real values. NEVER commit .env.

# REQUIRED in production — a long random string for JWT signing.
# The app REFUSES to start with the source's development key unless
# DEMOCRATE_ALLOW_DEV_SECRET=1 is set (local development only).
DEMOCRATE_SECRET_KEY=change-me-to-a-long-random-string

# Set to 1 ONLY for local development when you want to run without .env.
# DEMOCRATE_ALLOW_DEV_SECRET=1

# How long JWT tokens live, in minutes.
DEMOCRATE_TOKEN_TTL_MINUTES=60

# If set, this key gates TEACHER self-registration (/auth/register/teacher).
# Leave empty to disable teacher self-registration entirely (seed-only).
DEMOCRATE_TEACHER_KEY=

# Comma-separated list of allowed browser origins (CORS).
DEMOCRATE_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:8000

# Moderation threshold — weighted score at/below this flags a complaint for review.
DEMOCRATE_FALSE_THRESHOLD=-50
# Admin-confirmed false complaints before a student's submissions are restricted.
DEMOCRATE_FALSE_BAN_COUNT=5

# Rate limits (in-memory; single-process pilot).
DEMOCRATE_AUTH_RATE_LIMIT=20
DEMOCRATE_GENERAL_RATE_LIMIT=120
DEMOCRATE_RATE_WINDOW=60

# Provisioning (used by seed.py).
DEMOCRATE_ADMIN_USER=admin
DEMOCRATE_ADMIN_PASSWORD=
DEMOCRATE_SEED_PASSWORD=

# Optional: alternate DB (e.g. Postgres) for production.
DEMOCRATE_DATABASE_URL=sqlite:///./democrate.db
